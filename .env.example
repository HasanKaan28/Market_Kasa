# The Supabase project the app syncs with. Both values are public: the publishable key only
# reaches the database through the sync functions, which check every caller. Never put a
# secret or service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
